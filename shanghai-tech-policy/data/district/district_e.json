 {
  "title": "关于印发《崇明区创新型企业总部认定和奖励管理办法》的通知",
  "publishDate": "2023-12-01",
  "url": "https://www.shanghai.gov.cn/tsqygs-zjfcqj16/20250709/58427686a99f4b69bad0ffd632a81604_bcb.html",
  "docNo": "沪崇发改规〔2023〕1号",
  "issuer": "崇明区",
  "district": "崇明区",
  "category": "创新型中小企业",
  "noticeType": "政策红头文件",
  "conditions": [
   "第三条 申请认定创新型企业总部，应当符合下列条件",
   "（六）部分指标未达到但总体符合以上基本条件，对经济社会发展作出突出贡献，或具有突出行业影响力和带动作用的企业，经区政府同意并转报市政府同意后可作为特殊情况研究纳入",
   "（三）区发展改革委委托有资质的第三方专业机构对申报材料进行评估，对符合认定条件的相关申请提交至评审小组进行综合评审",
   "新型企业总部进行动态评估，对存在问题的企业提出整改意见并责令限期改正，对不再满足认定条件的企业，报市战新办同意后，及时取消其相关资格"
  ],
  "benefits": [
   "（一）对2022年1月1日以后在上海市注册或迁入上海市，目前工商注册地、财税户管地均在本区，新设法人实体企业的实缴注册资本超过1亿元的创新型企业总部，择优给予最高不超过500万元开办资助",
   "（三）创新型企业总部自2022年1月1日以来年销售收入首次达到5亿元、10亿元、15亿元，分别累计给予500万元、800万元、1000万元奖励"
  ],
  "pdfUrls": [
   "https://www.shanghai.gov.cn/cmsres/04/042fa82e89d64539abae1867c6111648/7b7275d1b2c5eef2167c1d5019d844d5.pdf"
  ]
 },
